IDENTIFICATION DIVISION.
PROGRAM-ID. DEPOSIT-REPORT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INPUT-FILE ASSIGN TO "deposits.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD INPUT-FILE.
01 INPUT-RECORD PIC X(20).

WORKING-STORAGE SECTION.
01 WS-BRANCH-CODE PIC X(3).
01 WS-PREV-BRANCH PIC X(3).

01 WS-DEPOSIT-AMOUNT PIC 9(9).
01 WS-BRANCH-TOTAL PIC 9(12) VALUE 0.
01 WS-GRAND-TOTAL PIC 9(12) VALUE 0.

01 WS-FIRST-RECORD PIC X VALUE 'Y'.
01 WS-EOF PIC X VALUE 'N'.

PROCEDURE DIVISION.
    OPEN INPUT INPUT-FILE

    PERFORM UNTIL WS-EOF = 'Y'
        READ INPUT-FILE
            AT END
                MOVE 'Y' TO WS-EOF
            NOT AT END
                PERFORM PROCESS-RECORD
        END-READ
    END-PERFORM

    IF WS-FIRST-RECORD = 'N'
        DISPLAY "Branch " WS-PREV-BRANCH
            ": " WS-BRANCH-TOTAL

        DISPLAY "Grand total: " WS-GRAND-TOTAL
    ELSE
        DISPLAY "Grand total: 0"
    END-IF

    CLOSE INPUT-FILE

    STOP RUN.

PROCESS-RECORD.
    UNSTRING INPUT-RECORD
        DELIMITED BY SPACE
        INTO WS-BRANCH-CODE WS-DEPOSIT-AMOUNT
    END-UNSTRING

    IF WS-FIRST-RECORD = 'Y'
        MOVE WS-BRANCH-CODE TO WS-PREV-BRANCH
        MOVE 'N' TO WS-FIRST-RECORD
    ELSE
        IF WS-BRANCH-CODE NOT = WS-PREV-BRANCH
            DISPLAY "Branch " WS-PREV-BRANCH
                ": " WS-BRANCH-TOTAL

            MOVE 0 TO WS-BRANCH-TOTAL
            MOVE WS-BRANCH-CODE TO WS-PREV-BRANCH
        END-IF
    END-IF

    ADD WS-DEPOSIT-AMOUNT TO WS-BRANCH-TOTAL
    ADD WS-DEPOSIT-AMOUNT TO WS-GRAND-TOTAL.