IDENTIFICATION DIVISION.
PROGRAM-ID. MUTATION-TEST.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 OLD_DATA.
05 OLD_DATE PIC X(10) VALUE "28-10-2026".
05 OLD_ACC1_AMOUNT PIC 9(3) VALUE 500.
05 OLD_ACC2_AMOUNT PIC 9(3) VALUE 300.
05 OLD_TOTAL PIC 9(3) VALUE 800.

01 NEW_DATA.
05 NEW_DATE PIC X(10) VALUE "29-10-2026".
05 NEW_ACC1_AMOUNT PIC 9(3) VALUE 500.
05 NEW_ACC2_AMOUNT PIC 9(3) VALUE 400.
05 NEW_TOTAL PIC 9(3) VALUE 900.

01 DIFFERENCE_COUNT PIC 9 VALUE 0.

01 TOTAL_MUTATIONS PIC 9 VALUE 2.
01 KILLED_MUTATIONS PIC 9 VALUE 0.
01 SURVIVED_MUTATIONS PIC 9 VALUE 0.
01 EQUIVALENT_MUTATIONS PIC 9 VALUE 0.

01 MUTATION_SCORE PIC 999V99 VALUE 0.

PROCEDURE DIVISION.

MAIN-PROCESS.

DISPLAY " "
DISPLAY "MUTATION TESTING:"
DISPLAY " "


DISPLAY "APPROVED REPORT:"
DISPLAY "RUN DATE: " OLD_DATE
DISPLAY "ACCOUNT 101 AMOUNT: " OLD_ACC1_AMOUNT
DISPLAY "ACCOUNT 102 AMOUNT: " OLD_ACC2_AMOUNT
DISPLAY "TOTAL: " OLD_TOTAL

DISPLAY " "
DISPLAY "NEW REPORT:"
DISPLAY "RUN DATE: " NEW_DATE
DISPLAY "ACCOUNT 101 AMOUNT: " NEW_ACC1_AMOUNT
DISPLAY "ACCOUNT 102 AMOUNT: " NEW_ACC2_AMOUNT
DISPLAY "TOTAL: " NEW_TOTAL

DISPLAY " "
DISPLAY "COMPARISON:"


IF OLD_ACC1_AMOUNT NOT = NEW_ACC1_AMOUNT
    DISPLAY "ACCOUNT 101: DIFFERENCE"
    ADD 1 TO DIFFERENCE_COUNT
ELSE
    DISPLAY "ACCOUNT 101: MATCH"
END-IF

IF OLD_ACC2_AMOUNT NOT = NEW_ACC2_AMOUNT
    DISPLAY "ACCOUNT 102: DIFFERENCE"
    ADD 1 TO DIFFERENCE_COUNT
ELSE
    DISPLAY "ACCOUNT 102: MATCH"
END-IF

IF OLD_TOTAL NOT = NEW_TOTAL
    DISPLAY "TOTAL: DIFFERENCE"
    ADD 1 TO DIFFERENCE_COUNT
ELSE
    DISPLAY "TOTAL: MATCH"
END-IF

DISPLAY "DATE IGNORED (VARIABLE FIELD)"

DISPLAY " "
DISPLAY "MUTATION RESULT:"

IF DIFFERENCE_COUNT > 0
    DISPLAY "STATUS: KILLED"
    MOVE DIFFERENCE_COUNT TO KILLED_MUTATIONS
ELSE
    DISPLAY "STATUS: SURVIVED"
    MOVE 1 TO SURVIVED_MUTATIONS
END-IF

COMPUTE MUTATION_SCORE =
   (KILLED_MUTATIONS / TOTAL_MUTATIONS) * 100

DISPLAY " "
DISPLAY "MUTATION SUMMARY:"
DISPLAY "TOTAL MUTATIONS: " TOTAL_MUTATIONS
DISPLAY "KILLED: " KILLED_MUTATIONS
DISPLAY "SURVIVED: " SURVIVED_MUTATIONS
DISPLAY "EQUIVALENT: " EQUIVALENT_MUTATIONS
DISPLAY "MUTATION SCORE: " MUTATION_SCORE "%"

STOP RUN.
